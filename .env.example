# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values. Everything is optional locally; see README "Environment variables".

# ── Supabase: where leads are stored (Project Settings → API Keys / Data API) ──
# The publishable key ("sb_publishable_...") is public by design: visitors can only
# submit leads through the submit_lead() database function, never read them.
# Never use the secret key ("sb_secret_...") here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Resend: email alert for every new lead (https://resend.com/api-keys) ──
RESEND_API_KEY=
# Where alerts are delivered. Controlled by the server, never by the form.
CONTACT_TO_EMAIL=mahi@novacovenanttrading.com
# Sender on a domain verified in Resend.
CONTACT_FROM_EMAIL=Nova Covenant Website <enquiries@novacovenanttrading.com>

# ── Cloudflare Turnstile: spam protection (Cloudflare dashboard → Turnstile) ──
# The site key is public (shown in the browser); the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Sheets: copy of each lead in your "Leads" sheet (google-apps-script/LeadsSheet.gs) ──
# The Web app URL from Apps Script → Deploy, and the same SECRET you set in that script.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# ── Optional: salt for hashing IP addresses used in rate limiting ──
# Any long random string. If empty, a fixed value derived from the Supabase URL is used.
IP_HASH_SALT=
